# Headers de segurança aplicados a todas as respostas.
# CSP propositalmente tolerante onde precisa (img/connect aceitam qualquer
# https) para não quebrar quando a URL da API mudar nem com escudos de times
# de URLs externas — mas bloqueia http inseguro, inline-script e enquadramento.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Arquivos que controlam o app e o service worker: sempre revalidar,
# pra atualização do PWA ser detectada sem ficar presa em cache do CDN.
/index.html
  Cache-Control: no-cache
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
